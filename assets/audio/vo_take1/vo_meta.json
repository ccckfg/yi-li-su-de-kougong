{
 "v01_gran_a": {
  "role": "gran",
  "text": "就剩这么些了……",
  "ms": 2496,
  "file": "audio/vo/v01_gran_a.wav"
 },
 "v01_gran_b": {
  "role": "gran",
  "text": "你可得对它好点儿啊。",
  "ms": 4307,
  "file": "audio/vo/v01_gran_b.wav"
 },
 "v02_01_int": {
  "role": "int",
  "text": "名字。",
  "ms": 847,
  "file": "audio/vo/v02_01_int.wav"
 },
 "v02_02_kid": {
  "role": "kid",
  "text": "……没有。",
  "ms": 1079,
  "file": "audio/vo/v02_02_kid.wav"
 },
 "v02_03_int": {
  "role": "int",
  "text": "没有？",
  "ms": 754,
  "file": "audio/vo/v02_03_int.wav"
 },
 "v02_04_kid": {
  "role": "kid",
  "text": "老太太管我叫黄毛。",
  "ms": 2205,
  "file": "audio/vo/v02_04_kid.wav"
 },
 "v02_05_kid": {
  "role": "kid",
  "text": "不是那种黄毛啊！我可老实了。",
  "ms": 2937,
  "file": "audio/vo/v02_05_kid.wav"
 },
 "v02_06_int": {
  "role": "int",
  "text": "多大？",
  "ms": 893,
  "file": "audio/vo/v02_06_int.wav"
 },
 "v02_07_kid": {
  "role": "kid",
  "text": "今年秋天刚生的。",
  "ms": 1741,
  "file": "audio/vo/v02_07_kid.wav"
 },
 "v02_08_int": {
  "role": "int",
  "text": "这上头写着，你在她家住了四十多年。",
  "ms": 3320,
  "file": "audio/vo/v02_08_int.wav"
 },
 "v02_09_kid": {
  "role": "kid",
  "text": "那是我爸，我爷，我太爷……我们一家子都住那儿，一辈接一辈的。",
  "ms": 5584,
  "file": "audio/vo/v02_09_kid.wav"
 },
 "v02_10_kid": {
  "role": "kid",
  "text": "哎哎哎，拿走拿走！",
  "ms": 2054,
  "file": "audio/vo/v02_10_kid.wav"
 },
 "v02_11_int": {
  "role": "int",
  "text": "一杯水，你怕什么。",
  "ms": 2100,
  "file": "audio/vo/v02_11_int.wav"
 },
 "v02_12_kid": {
  "role": "kid",
  "text": "我沾水就得开口！开了口就收不回去了！",
  "ms": 4295,
  "file": "audio/vo/v02_12_kid.wav"
 },
 "v02_13_int": {
  "role": "int",
  "text": "……家里还有什么亲戚？",
  "ms": 1346,
  "file": "audio/vo/v02_13_int.wav"
 },
 "v02_14_kid": {
  "role": "kid",
  "text": "有个远房的。路边上、墙根底下，到处都是，你肯定见过。",
  "ms": 6164,
  "file": "audio/vo/v02_14_kid.wav"
 },
 "v02_15_int": {
  "role": "int",
  "text": "叫什么？",
  "ms": 940,
  "file": "audio/vo/v02_15_int.wav"
 },
 "v02_16_kid": {
  "role": "kid",
  "text": "不告诉你。说出来丢人。",
  "ms": 2089,
  "file": "audio/vo/v02_16_kid.wav"
 },
 "v02_17_int": {
  "role": "int",
  "text": "(sighs)有什么特长？",
  "ms": 2101,
  "file": "audio/vo/v02_17_int.wav"
 },
 "v02_18_kid": {
  "role": "kid",
  "text": "耐旱，不挑地，石头缝里都能活。还有……熬粥特别香。",
  "ms": 5619,
  "file": "audio/vo/v02_18_kid.wav"
 },
 "v02_19_int": {
  "role": "int",
  "text": "知道为什么带你来吗？",
  "ms": 1600,
  "file": "audio/vo/v02_19_int.wav"
 },
 "v02_20_kid": {
  "role": "kid",
  "text": "不知道……我又不值钱。",
  "ms": 2554,
  "file": "audio/vo/v02_20_kid.wav"
 },
 "v02_21_int": {
  "role": "int",
  "text": "最后一个问题。你到底多大了？",
  "ms": 2774,
  "file": "audio/vo/v02_21_int.wav"
 },
 "v02_22_kid": {
  "role": "kid",
  "text": "你是问我，还是问我们？",
  "ms": 2472,
  "file": "audio/vo/v02_22_kid.wav"
 },
 "v02_23_int": {
  "role": "int",
  "text": "你们。",
  "ms": 847,
  "file": "audio/vo/v02_23_int.wav"
 },
 "v02_24_kid": {
  "role": "kid",
  "text": "……一万年吧。差不多。",
  "ms": 2600,
  "file": "audio/vo/v02_24_kid.wav"
 },
 "v02_24_old": {
  "role": "old",
  "text": "……一万年吧。差不多。",
  "ms": 2356,
  "file": "audio/vo/v02_24_old.wav"
 },
 "v03_1": {
  "role": "old",
  "text": "那会儿我还是根野草，一熟就往地上掉。有人专掐那些熟了还不掉的。",
  "ms": 8568,
  "file": "audio/vo/v03_1.wav"
 },
 "v03_2": {
  "role": "old",
  "text": "后来就住进罐子里了。这习惯，我们家留到了今天。",
  "ms": 5746,
  "file": "audio/vo/v03_2.wav"
 },
 "v03_3": {
  "role": "old",
  "text": "他们在骨头上刻我。刻得还挺像，熟透的谷子，都低着头。",
  "ms": 6443,
  "file": "audio/vo/v03_3.wav"
 },
 "v03_4": {
  "role": "old",
  "text": "有人写诗，说我是老天爷赏的。我也没好意思吭声。",
  "ms": 4829,
  "file": "audio/vo/v03_4.wav"
 },
 "v03_5": {
  "role": "old",
  "text": "贾思勰把怎么挑我写下来了：挑好穗子，割下来，挂高。后来的人照着做了一千多年。",
  "ms": 10100,
  "file": "audio/vo/v03_5.wav"
 },
 "v03_6": {
  "role": "old",
  "text": "这句你们都会背吧？背的时候，想过那一粒是打哪来的吗？",
  "ms": 5607,
  "file": "audio/vo/v03_6.wav"
 },
 "v03_7": {
  "role": "old",
  "text": "老宋写书，粮食放第一篇，珠宝放最后一篇。这人，我喜欢。",
  "ms": 6443,
  "file": "audio/vo/v03_7.wav"
 },
 "v03_8": {
  "role": "old",
  "text": "小米加步枪。那几年……我是真扛过事儿的。",
  "ms": 5305,
  "file": "audio/vo/v03_8.wav"
 },
 "v04_old": {
  "role": "old",
  "text": "……谁让你们查的。",
  "ms": 1700,
  "file": "audio/vo/v04_old.wav"
 },
 "v05_01_old": {
  "role": "old",
  "text": "那你到底……带我来干啥？",
  "ms": 2739,
  "file": "audio/vo/v05_01_old.wav"
 },
 "v05_02_man": {
  "role": "man",
  "text": "(sighs)那老太太八十三了。儿子们早不种这个了。",
  "ms": 5900,
  "file": "audio/vo/v05_02_man.wav"
 },
 "v05_03_man": {
  "role": "man",
  "text": "哪天她不在了，坛子一收拾，你们就全没了。",
  "ms": 5300,
  "file": "audio/vo/v05_03_man.wav"
 },
 "v05_04_man": {
  "role": "man",
  "text": "抓你干啥。接你来的。",
  "ms": 2400,
  "file": "audio/vo/v05_04_man.wav"
 },
 "v05_05_old": {
  "role": "old",
  "text": "后来隔壁袋子跟我说，这老头干这个快四十年了。黑龙江到海南，一家一家敲门，就为讨一把种子。",
  "ms": 10623,
  "file": "audio/vo/v05_05_old.wav"
 },
 "v05_06_old": {
  "role": "old",
  "text": "房梁换成了铁架子，肉眼换成了测序仪。弯腰那一下，一直没变。",
  "ms": 6745,
  "file": "audio/vo/v05_06_old.wav"
 },
 "v05_07_old": {
  "role": "old",
  "text": "都说好种子是老天爷赏的。我活了一万年，老天爷一回没见着。见着的，全是这样的人。",
  "ms": 8568,
  "file": "audio/vo/v05_07_old.wav"
 },
 "v05_08_old": {
  "role": "old",
  "text": "……行吧。",
  "ms": 1253,
  "file": "audio/vo/v05_08_old.wav"
 },
 "v05_09_kid": {
  "role": "kid",
  "text": "我招。",
  "ms": 928,
  "file": "audio/vo/v05_09_kid.wav"
 }
}